# syntax=docker/dockerfile:1
# Preserved V1 MCP execution service: Node application + pinned Terraform CLI.
FROM node:20-slim AS app
WORKDIR /app
COPY package.json index.js ./
RUN mkdir -p /app/evidence && chown -R 65532:65532 /app

FROM hashicorp/terraform:1.8.5 AS terraform

FROM gcr.io/distroless/nodejs20-debian12:nonroot
WORKDIR /app
COPY --from=terraform /bin/terraform /usr/local/bin/terraform
COPY --from=app --chown=65532:65532 /app /app
ENV PATH="/usr/local/bin:/usr/bin:/bin"
EXPOSE 8080
CMD ["index.js"]
